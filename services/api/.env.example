ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://contraict:contraict@localhost:5432/contraict
REDIS_URL=redis://localhost:6379/0

# dev: trust X-Dev-User-Email header (local only). clerk: verify Clerk JWTs.
AUTH_MODE=dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]

CORS_ORIGINS=["http://localhost:3000"]

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=contraict-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=high

# Files: "local" (disk, development) or "s3" (S3/MinIO).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.storage

# Process uploads inside the API process (no Celery worker needed for local development).
TASKS_EAGER=true

# Links in emails and calendar feeds.
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Email: console (log only), smtp or postmark.
EMAIL_BACKEND=console
EMAIL_FROM=TheContrAIct <reminders@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
POSTMARK_SERVER_TOKEN=
